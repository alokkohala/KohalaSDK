{
  "name": "@kohala/react",
  "version": "0.3.4",
  "description": "React hooks and components for the Kohala API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alokkohala/KohalaSDK.git",
    "directory": "packages/react"
  },
  "homepage": "https://kohala.ai/developers",
  "bugs": {
    "url": "https://kohala.ai/contact"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kohala",
    "react",
    "hooks",
    "ai",
    "agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "dependencies": {
    "@kohala/sdk": "^0.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
